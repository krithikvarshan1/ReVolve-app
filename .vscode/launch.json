{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "revolve (Chrome with Firebase)",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--dart-define-from-file=.firebase/web.json",
        "--dart-define=ML_BACKEND_URL=http://127.0.0.1:8000"
      ]
    }
  ]
}
